DATABASE_URL=mysql://user:password@host:3306/review_intelligence?ssl-mode=REQUIRED
MYSQL_DATABASE=review_intelligence
MYSQL_CA_CERT=
MYSQL_CA_CERT_PATH=
MYSQL_SSL_REJECT_UNAUTHORIZED=true
APP_DATA_DIR=./data
APP_UPLOAD_DIR=./data/uploads
